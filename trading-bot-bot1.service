[Unit]
Description=Trading Bot bot1
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading
Environment=PATH=/home/ubuntu/trading/trading_bot_env/bin
ExecStart=/home/ubuntu/trading/trading_bot_env/bin/python /home/ubuntu/trading/Bots_adaptables/bot1/bot1.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
# Agregar límites de recursos para prevenir cuelgues por memoria
MemoryLimit=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
<parameter name="filePath">c:\Users\ACER\Documents\trading\trading-bot-atom.service