[Unit]
Description=Trading Bot bot1
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bots/bot1/botadaptable1
ExecStart=/usr/bin/python3 /home/ubuntu/bots/bot1/botadaptable1/bot1.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
# Agregar límites de recursos para prevenir cuelgues por memoria
MemoryLimit=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target